<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Удалённое управление телефоном с ПК (REMOTE-XDEV): foreground-сервис держит long-poll релэя. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Доступ ко всем файлам — пользователь выдаёт сам в системных настройках (агент работает с реальными файлами). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Календарь — читает/создаёт события локально (S10), доступ выдаёт пользователь. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Контакты — инструменты contacts_list/contacts_search (§7: приватные данные, не уходят в облако). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Железо/сеть: vibrate, wifi_info. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- installed_apps (список приложений) и keep_screen_on (wake lock). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Исключение из оптимизации батареи: без него агрессивные OEM убивают foreground-сервис генерации
         в фоне. Запрашивается по согласию пользователя (BatteryOptimization), когда идёт локальная генерация. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- NFC (nfc_read/nfc_write через foreground reader-mode); не обязателен — ставится и без чипа. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <!-- Связь/контролы: sms_send/read, contacts_create, set_brightness, dnd_mode. Все — с подтверждением;
         WRITE_SETTINGS и ACCESS_NOTIFICATION_POLICY — особые доступы (пользователь выдаёт вручную). -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- make_call: прямой набор (ACTION_CALL). Без разрешения инструмент откатывается на ACTION_DIAL. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- set_wallpaper — обычное (не runtime) разрешение: пользователь ничего не подтверждает,
         но без строки WallpaperManager.setBitmap бросит SecurityException. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- camera_capture снимает системным приложением (наше CAMERA-разрешение не нужно); камера не обязательна. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:label="Plus AI"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- S11: управление телефоном. Включается пользователем в системных настройках. -->
        <service
            android:name=".phone.PhoneControlService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- REMOTE-XDEV: телефоном управляет ПК. Включается пользователем в настройках. -->
        <service
            android:name=".remote.RemoteAgentService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Держит процесс живым на время генерации: ответ не обрывается при сворачивании/закрытии. -->
        <service
            android:name=".GenerationService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- share_file: отдаёт файлы песочницы наружу через content:// (пути в @xml/file_paths). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
