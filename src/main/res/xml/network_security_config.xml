<?xml version="1.0" encoding="utf-8"?>
<!--
  A4: по умолчанию cleartext (http://) ЗАПРЕЩЁН — логин/пароль, Bearer кошелька и текст
  промптов не уйдут открытым HTTP даже при опечатке в URL сервера/прокси. Локальный llama.cpp
  работает через JNI (не по сети), поэтому http нигде не нужен; localhost оставлен на всякий
  случай для локальной отладки.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
